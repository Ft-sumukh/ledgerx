# ==============================================================================
# LEDGER-X ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledgerx?schema=public

# Authentication & Security
AUTH_SECRET=replace_with_a_secure_random_64_character_hex_secret
SESSION_MAX_AGE_SECONDS=86400

# Financial Engine Settings
DEFAULT_CURRENCY=USD
DECIMAL_PRECISION=4
MAX_TRANSACTION_ENTRIES=100
